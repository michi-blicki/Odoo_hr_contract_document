<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================== -->
    <!-- HR Contract Document Snippet Views                         -->
    <!-- ========================================================== -->
    <data>
    
        <record id="view_hr_contract_document_snippet_tree" model="ir.ui.view">
            <field name="name">hr.contract.document.snippet.tree</field>
            <field name="model">hr.contract.document.snippet</field>
            <field name="arch" type="xml">
                <list string="Text Snippets" default_order="sequence">
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="is_mandatory"/>
                    <field name="force_page_break_before"/>
                    <field name="version"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_hr_contract_document_snippet_form" model="ir.ui.view">
            <field name="name">hr.contract.document.snippet.form</field>
            <field name="model">hr.contract.document.snippet</field>
            <field name="arch" type="xml">
                <form string="Text Snippet">
                    <header>
                        <button name="action_send_to_review" string="Send to Review" type="object"
                                invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_activate" string="Activate" type="object"
                                invisible="state != 'review'" class="oe_highlight"/>
                        <button name="action_archive" string="Archive" type="object"
                                invisible="state not in ('draft', 'review', 'active')" class="oe_link"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                                invisible="state not in ('review', 'active')" class="oe_link"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,review,active,archived"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="sequence"/>
                                <field name="is_mandatory"/>
                                <field name="force_page_break_before"/>
                                <field name="version" readonly="1"/>
                            </group>
                            <group>
                                <field name="company_ids" widget="many2many_tags" readonly="0"/>
                            </group>
                        </group>
                        <group>
                            <div class="alert alert-info mt16 mb0" role="alert">
                                <strong>Notes:</strong><br/>
                                You can use placeholders to insert information from the employee record or other related models. 
                                For example: <code>{{ employee.name }}</code>,  <code>{{ employee.department_id.name }}</code>, etc.<br />
                                You can use conditions to include or exclude parts of content based on certain criteria.
                                For example: <code>{% if employee.department_id.name == 'HR' %} ... {% endif %}</code>.
                            </div>
                            <field name="content_html" widget="html"/>
                        </group>
                        <group>
                            <field name="placeholder_fields" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_contract_document_snippet" model="ir.actions.act_window">
            <field name="name">Text Snippets</field>
            <field name="res_model">hr.contract.document.snippet</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_contract_snippets"
                name="Text Snippets"
                parent="menu_hr_contract_document_root"
                action="action_hr_contract_document_snippet"
        />
    
    </data>
          
</odoo>
