<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================== -->
    <!-- HR Contract Document Signer Rule Views                     -->
    <!-- ========================================================== -->
    <data>
    
        <record id="view_hr_contract_document_signer_rule_tree" model="ir.ui.view">
            <field name="name">hr.contract.document.signer.rule.tree</field>
            <field name="model">hr.contract.document.signer.rule</field>
            <field name="arch" type="xml">
                <list string="Signer Rules" default_order="sequence asc">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="relation_rule"/>
                    <field name="is_mandatory"/>
                    <field name="template_id"/>
                </list>
            </field>
        </record>

        <record id="view_hr_contract_document_signer_rule_form" model="ir.ui.view">
            <field name="name">hr.contract.document.signer.rule.form</field>
            <field name="model">hr.contract.document.signer.rule</field>
            <field name="arch" type="xml">
                <form string="Signer Rule">
                    <sheet>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="relation_rule" placeholder="employee.parent_id.user_id"/>
                            <field name="is_mandatory"/>
                        </group>
                        <field name="template_id"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_contract_document_signer_rule" model="ir.actions.act_window">
            <field name="name">Signer Rules</field>
            <field name="res_model">hr.contract.document.signer.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_contract_signer_rules"
                name="Signer Rules"
                parent="menu_hr_contract_document_root"
                groups="hr_contract_document.group_hr_contract_document_admin"
                action="action_hr_contract_document_signer_rule"
        />
    
    </data>

</odoo>
