<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================== -->
    <!-- HR Contract Document Attachment Views                      -->
    <!-- ========================================================== -->
    <data>
    
        <record id="view_hr_contract_document_attachment_tree" model="ir.ui.view">
            <field name="name">hr.contract.document.attachment.tree</field>
            <field name="model">hr.contract.document.attachment</field>
            <field name="arch" type="xml">
                <list string="Attachments">
                    <field name="name"/>
                    <field name="is_mandatory"/>
                    <field name="language"/>
                    <field name="state"/>
                    <field name="version"/>
                    <field name="template_id"/>
                </list>
            </field>
        </record>

        <record id="view_hr_contract_document_attachment_form" model="ir.ui.view">
            <field name="name">hr.contract.document.attachment.form</field>
            <field name="model">hr.contract.document.attachment</field>
            <field name="arch" type="xml">
                <form string="Attachment">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="document_ref_id"/>
                                <field name="is_mandatory"/>
                                <field name="language"/>
                                <field name="version"/>
                            </group>
                            <group>
                                <field name="template_id"/>
                                <field name="state"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_contract_document_attachment" model="ir.actions.act_window">
            <field name="name">Attachments</field>
            <field name="res_model">hr.contract.document.attachment</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_contract_attachments"
                name="Attachments"
                parent="menu_hr_contract_document_root"
                action="action_hr_contract_document_attachment"
        />

    </data>
              
</odoo>
