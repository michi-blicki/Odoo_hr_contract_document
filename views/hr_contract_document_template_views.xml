<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ========================================================== -->
    <!-- HR Contract Document Template Views                        -->
    <!-- ========================================================== -->

    <record id="view_hr_contract_document_template_tree" model="ir.ui.view">
        <field name="name">hr.contract.document.template.tree</field>
        <field name="model">hr.contract.document.template</field>
        <field name="arch" type="xml">
            <tree default_order="name asc">
                <field name="name"/>
                <field name="version"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_contract_document_template_form" model="ir.ui.view">
        <field name="name">hr.contract.document.template.form</field>
        <field name="model">hr.contract.document.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            states="draft,review" class="oe_highlight"/>
                    <button name="action_archive" string="Archive" type="object"
                            states="active" class="oe_link"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,active,archived"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="version" readonly="1"/>
                            <field name="company_id"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="css_style" widget="text"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Snippets">
                            <field name="snippet_ids" context="{'default_template_id': active_id}">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="is_mandatory"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Attachments">
                            <field name="attachment_ids" context="{'default_template_id': active_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="is_mandatory"/>
                                    <field name="language"/>
                                    <field name="version"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Signer Rules">
                            <field name="signer_rule_ids" context="{'default_template_id': active_id}">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="relation_rule"/>
                                    <field name="is_mandatory"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_contract_document_template" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">hr.contract.document.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
