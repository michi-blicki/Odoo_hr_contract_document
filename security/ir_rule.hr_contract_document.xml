<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_document_template_rule_multi_company" model="ir.rule">
        <field name="name">HR Contract Document Template: multi-company access</field>
        <field name="model_id" ref="model_hr_contract_document_template"/>
        <field name="groups" eval="[
            (4, ref('hr_contract_document.group_hr_contract_document_user')),
        ]" />
        <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', user.company_ids.ids)]</field>
    </record>

    <record id="hr_contract_document_snippet_rule_multi_company" model="ir.rule">
        <field name="name">HR Contract Document Snippet: multi-company access</field>
        <field name="model_id" ref="model_hr_contract_document_snippet"/>
        <field name="groups" eval="[
            (4, ref('hr_contract_document.group_hr_contract_document_user')),
        ]" />
        <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', user.company_ids.ids)]</field>
    </record>
    
</odoo>
