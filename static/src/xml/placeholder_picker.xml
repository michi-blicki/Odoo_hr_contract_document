<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_contract_document.PlaceholderPickerDialog" owl="1">
        <Dialog title="Insert Placeholder" size="'md'">
            <div class="placeholder-picker-content">
                <p class="text-muted" style="margin-bottom: 15px;">
                    Select a placeholder to insert it at the cursor position:
                </p>
                <div class="placeholder-list">
                    <t t-foreach="placeholders" t-as="placeholder">
                        <div class="placeholder-item" 
                             t-on-click="() => selectPlaceholder(placeholder)"
                             style="padding: 10px; margin: 5px 0; border: 1px solid #e0e0e0; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
                            <div class="placeholder-label">
                                <strong t-esc="placeholder.label"/>
                            </div>
                            <div class="placeholder-key" style="color: #666; font-family: monospace; font-size: 12px; margin-top: 4px;">
                                <code t-esc="`${'$'}{${placeholder.key}}`"/>
                            </div>
                            <div class="placeholder-description" style="color: #999; font-size: 11px; margin-top: 4px;">
                                <t t-esc="placeholder.description"/>
                            </div>
                        </div>
                    </t>
                </div>
                <p class="text-muted" style="margin-top: 15px; padding-top: 10px; border-top: 1px solid #e0e0e0; font-size: 12px;">
                    💡 Tip: Make sure your cursor is positioned in the content editor before inserting.
                </p>
            </div>
        </Dialog>
    </t>

</templates>
