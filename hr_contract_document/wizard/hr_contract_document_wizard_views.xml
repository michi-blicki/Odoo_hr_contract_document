<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_document_wizard_form" model="ir.ui.view">
        <field name="name">hr.contract.document.wizard.form</field>
        <field name="model">hr.contract.document.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Contract Document">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="template_id" 
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="template_type" readonly="1" invisible="not template_id"/>
                    <field name="language" readonly="1" invisible="not template_id"/>
                    <field name="document_name" placeholder="e.g. Employment Contract - John Doe"/>
                </group>
                <footer>
                    <button string="Generate Document" 
                            name="action_generate" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
